# MongoDB connection string
MONGODB_URI=

# Node environment (development | production | test)
NODE_ENV=development

# Single-service hosting (Render): build both apps, then serve client/dist.
# Leave disabled when Nginx serves the frontend separately.
SERVE_FRONTEND=false
# Recovery/production deployment: avoid creating or modifying demo data.
SKIP_SEED=true
SESSION_SECRET=
FRONTEND_URL=https://blackhevents.com

# Paystack API Keys
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Optional: Enable Paystack subaccount split payments
PAYSTACK_SPLIT_PAYMENTS_ENABLED=false

# Transactional Email (Resend)
RESEND_API_KEY=

# AI Extraction (Google Gemini)
GEMINI_API_KEY=

# Google OAuth (Social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base public domain
BASE_URL=https://blackhevents.com
PUBLIC_APP_URL=https://blackhevents.com

# Demo Mode toggle (when true, isolates demo records)
DEMO_MODE=false

# Monnify: sends organizer withdrawals when chosen in Admin → Instant payouts.
# MONNIFY_MODE=live switches from https://sandbox.monnify.com to https://api.monnify.com.
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_WALLET_ACCOUNT=
MONNIFY_MODE=sandbox
